{
  "name": "pulseboard",
  "version": "0.1.0",
  "description": "Pulseboard is a local-first webhook dashboard for capturing, inspecting, replaying, and forwarding webhooks.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "bin": {
    "pulseboard": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api,sender -c magenta,blue,yellow \"vite\" \"PULSEBOARD_DEV_PROXY=http://localhost:5173 tsx watch src/cli.ts --port 4500 --db .pulseboard/dev.db --forward http://localhost:3999\" \"tsx scripts/dev-sender.ts\"",
    "build": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\" && vite build && tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs=>fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true}))\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "smoke:package": "tsx scripts/smoke-package.ts",
    "smoke:docker": "tsx scripts/smoke-docker.ts",
    "release:check": "pnpm typecheck && pnpm test && pnpm audit --prod --audit-level high && pnpm test:e2e && pnpm smoke:package && pnpm smoke:docker",
    "start": "node dist/cli.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/static": "^10.1.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "lucide-react": "^0.451.0",
    "nanoid": "^5.0.7",
    "picocolors": "^1.0.1",
    "pino-pretty": "^11.2.2",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
