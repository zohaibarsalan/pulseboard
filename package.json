{
  "name": "webhook-studio",
  "version": "0.1.0-pre",
  "description": "Local-first webhook studio — capture, inspect, replay, and forward webhooks. Postman for incoming requests.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "bin": {
    "webhook-studio": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api,sender -c magenta,blue,yellow \"vite\" \"WEBHOOK_STUDIO_DEV_PROXY=http://localhost:5173 tsx watch src/cli.ts --port 4500 --db .webhook-studio/dev.db --forward http://localhost:3999\" \"tsx scripts/dev-sender.ts\"",
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs=>fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true}))\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/cli.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/http-proxy": "^9.5.0",
    "@fastify/static": "^7.0.4",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^11.3.0",
    "cmdk": "^1.1.1",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^4.28.1",
    "lucide-react": "^0.451.0",
    "nanoid": "^5.0.7",
    "picocolors": "^1.0.1",
    "pino-pretty": "^11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
